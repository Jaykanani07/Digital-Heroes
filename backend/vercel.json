{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "{assets/**,supabase/**,node_modules/pdfjs-dist/standard_fonts/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
