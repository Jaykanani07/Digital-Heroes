# ----------------------------------------------------------------------------
# Digital Heroes API — copy to .env and fill in. Never commit .env.
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Storefront URL(s), comma separated (CORS + links in e-mails + Stripe redirects)
FRONTEND_URL=http://localhost:3000

# Supabase → Project Settings → Database → Connection string (URI).
# On Vercel use the "Transaction pooler" URI (port 6543).
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# SSL is switched on automatically for Supabase URLs. Set to "true"/"false" to force it.
DB_SSL=

# Long random string used to sign login tokens (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# Supabase → Project Settings → API. Files go to a PRIVATE bucket (created automatically).
# Leave empty in local dev to store files in ./storage instead.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=print-files

# Stripe (test keys). Leave empty to run in TEST PAYMENT mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP for e-mail notifications. Leave empty to print e-mails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Digital Heroes <no-reply@digitalheroes.co.in>
# Production team inbox for new orders / approvals / change requests
ADMIN_NOTIFY_EMAIL=

VAT_RATE=0.18
CURRENCY=INR

# Administrator account — create it with: npm run create-admin
ADMIN_EMAIL=admin@digitalheroes.co.in
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Studio Admin
